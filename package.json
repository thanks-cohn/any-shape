{
  "name": "@any-shape/core",
  "version": "0.1.0",
  "description": "Portable CSS layout primitives and opt-in, redaction-safe layout diagnostics",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/diagnostics.d.ts",
      "import": "./src/diagnostics.js"
    },
    "./css": "./src/any-shape.css",
    "./schema": "./src/diagnostic.schema.json"
  },
  "files": [
    "src",
    "examples",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "dev": "node scripts/serve.js",
    "test:unit": "node --test tests/unit.test.js tests/server.test.js",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run test:unit && npm run typecheck && npm run test:browser",
    "test:recovery": "node scripts/recovery.js",
    "test:package": "node scripts/package-smoke.js",
    "prepare:cloud": "bash scripts/prepare-cloud-browsers.sh",
    "check:forever": "node scripts/validate-forever.mjs",
    "test:browser:isolated": "playwright test --config scripts/browser-isolated.config.mjs",
    "test:forever": "node --test tests/forever.test.mjs",
    "prepack": "npm run test:unit && npm run typecheck",
    "build:openform-schema": "node scripts/build-openform-schema.mjs",
    "check:openform-schema": "npm run build:openform-schema && node --check examples/openform-schema/app.js",
    "dev:webhook-lab": "node scripts/webhook-lab.mjs",
    "test:webhook-lab": "node --test tests/webhook-lab.test.mjs",
    "test:destinations": "node --test tests/destination-effects.test.mjs tests/webhook-lab.test.mjs",
    "test:website-export": "node --test tests/website-export.test.mjs",
    "test:deployment-lab": "node --test tests/cloudflare-pages-reference.test.mjs",
    "pipeline": "node reconstruction/extension-pipeline/bin/any-shape.mjs",
    "test:pipeline": "node --test reconstruction/extension-pipeline/tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "acorn": "8.15.0",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "parse5": "7.3.0",
    "typescript": "5.9.3"
  }
}
