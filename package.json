{
  "name": "@any-shape/core",
  "version": "0.1.0",
  "description": "Portable CSS layout primitives and opt-in, redaction-safe layout diagnostics",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./src/diagnostics.d.ts", "import": "./src/diagnostics.js" },
    "./css": "./src/any-shape.css",
    "./schema": "./src/diagnostic.schema.json"
  },
  "files": ["src", "examples", "LICENSE", "docs"],
  "scripts": {
    "dev": "node scripts/serve.js",
    "test:unit": "node --test tests/unit.test.js tests/server.test.js",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run test:unit && npm run typecheck && npm run test:browser",
    "test:recovery": "node scripts/recovery.js",
    "test:package": "node scripts/package-smoke.js",
    "prepare:cloud": "bash scripts/prepare-cloud-browsers.sh",
    "prepack": "npm run test:unit && npm run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "typescript": "5.9.3"
  }
}
